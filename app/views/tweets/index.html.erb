<div class="hero">
  <div>
    <h1>君が見つけた君だけの道</h1>
    <p class="subtitle">
      道路でつながる、新しいコミュニティ。
    </p>

    <%= link_to "新規投稿へ", new_tweet_path, class:"main-button" %>
  </div>
</div>

<div class="search-box">
<%= form_tag({controller:"tweets",action:"index"},method: :get) do %>
  <%= text_field_tag :search, params[:search], placeholder:"道路名で検索..." %>
  <%= submit_tag "検索" %>
<% end %>
</div>

<h3>軌跡</h3>
<h3>お店部門</h3>

<div class="tweets-container">
  <% @tweets.each do |t| %>

    <% if t.shop_detail.present? %>
      <div class="tweet">

        <p>名前：<%= t.road %></p>
        <p>日付：<%= t.day %></p>
        <p>場所：<%= t.address %></p>
        <p>お店：<%= t.shop_detail %></p>

        <%= link_to "詳細へ", tweet_path(t.id) %>
        <%= link_to "編集する", edit_tweet_path(t.id) %>
        <%= button_to "削除する",
            tweet_path(t.id),
            method: :delete,
            data: { turbo_confirm: "本当に削除しますか？" } %>

      </div>
    <% end %>

  <% end %>
</div>


