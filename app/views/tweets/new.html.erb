<h1>(なるのさいと)</h1>
<h3>新規投稿ページ</h3>
<%= form_for @tweet do  |f| %>


  <div class="field">
    <%= f.label :名前 %>
    <%= f.text_field :road, :size => 30 %>
  </div>


  <div class="field">
    <%= f.label :日付け  %>
     <%= f.text_field :day, :size => 30 %>
  </div>

 <div class="field">
    <%= f.label :場所  %>
    <%= f.text_field :address, :size => 30 %>
  </div>


  <div class="field">
    <%= f.label :詳細  %>
    <%= f.text_area :about, :size => "30x2" %>
  </div>

  <%= f.submit "投稿する" %>
<% end %>

<%= link_to "一覧に戻る", tweets_path %>

<%= stylesheet_link_tag 'new', :media => "all" %>

<div class="post-container">
    <p class="title">投稿フォーム</p>
    <%= form_for(@tweet, :url => { controller:'tweets', action:'create'})do |f| %>
    <%= f.label :投稿内容 %>
        <br>
        <%= f.text_field :body,size: 140%>
        <br>
    <%= f.submit "送信"%>
    <br>
    <% end %>
</div>